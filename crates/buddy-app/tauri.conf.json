{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desk-buddy",
  "version": "0.1.0",
  "identifier": "dev.deskbuddy.app",
  "build": { "frontendDist": "web" },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "security": { "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"],
    "macOS": { "infoPlist": "Info.plist" }
  }
}
